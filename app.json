{
  "expo": {
    "name": "Wakey",
    "slug": "wakey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wakey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "deploymentTarget": "17.0",
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "NSAlarmKitUsageDescription": "This application requires permission to schedule and manage alarms.",
        "NSCameraUsageDescription": "Wakey uses the camera to verify you've completed your wake-up challenge.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.tsouvili.wakey",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tsouvili.wakey"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tsouvili.wakey"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "./src/plugins/withAlarmKit.js",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.tsouvili.wakey",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "NextAlarmWidget",
              "displayName": "Next Alarm",
              "description": "Displays your next scheduled alarm.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      "expo-asset",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/ios-dark.png",
          "color": "#ffffff",
          "defaultChannel": "meeting-reminders",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.tsouvili.wakey.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tsouvili.wakey"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "efeeed15-c103-43f1-885f-fb6ac93b6791"
      }
    }
  }
}